{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlgoJava",
  "version": "0.1.0",
  "identifier": "uz.awe.algojava",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AlgoJava",
        "width": 1320,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:algojava.db"]
    },
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  }
}
