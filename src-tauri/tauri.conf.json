{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlgoJava",
  "version": "1.0.0-alpha.1",
  "identifier": "uz.awe.algojava",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AlgoJava",
        "width": 1320,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#090912",
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "AlgoJava",
        "url": "splash.html",
        "width": 600,
        "height": 360,
        "resizable": false,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "backgroundColor": "#090912",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "publisher": "Dilshod Fayzullayev (Dylan)",
    "shortDescription": "Offline-first Java coding practice desktop studio",
    "longDescription": "AlgoJava is a 100% free and offline desktop edition inspired by codingbat.com for practicing Java algorithms locally with your installed JDK.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "version": "1.0.0.1"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:algojava.db"]
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/cto-mindset/algojava-releases/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
